{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "currency",
    "amounts",
    "status"
  ],
  "properties": {
    "currency": {
      "type": "string"
    },
    "amounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value",
          "source"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}