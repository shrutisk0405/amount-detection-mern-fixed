{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "raw_tokens",
    "currency_hint",
    "confidence"
  ],
  "properties": {
    "raw_tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currency_hint": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}