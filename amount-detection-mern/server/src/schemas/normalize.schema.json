{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "normalized_amounts",
    "normalization_confidence"
  ],
  "properties": {
    "normalized_amounts": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "normalization_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}